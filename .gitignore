# AI/agent notes — not part of the app
AGENTS.md

# client TLS credentials (generated at runtime on the SD card)
keys/

# main build outputs (regenerated by make; removed by make clean)
/build/
*.dol
*.elf
*.map
dist/

# ffmpeg: source is committed, all compilation happens at runtime
*.o
*.d
third_party/ffmpeg-wii/**/*.a
third_party/ffmpeg-wii/src/version.h
third_party/ffmpeg-wii/src/.version
third_party/ffmpeg-wii/src/.config
# tablegen host tools and generated table headers (built at runtime)
third_party/ffmpeg-wii/src/libavcodec/*_tablegen
third_party/ffmpeg-wii/src/libavcodec/*_tables.h

# stale WiiU-era entries (harmless, kept for safety)
/.vscode/
*.wuhb
*.rpx
*.gsh
*.zip
latte-assembler
